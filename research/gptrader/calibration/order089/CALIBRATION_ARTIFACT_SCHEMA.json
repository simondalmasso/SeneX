{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senex.local/schemas/order089-calibration-artifact-v1.json",
  "title": "SENEX Decision-Agent Calibration Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "calibration_id",
    "decision_protocol_version",
    "source_epochs",
    "windows",
    "parameters",
    "frozen",
    "objective",
    "constraints",
    "code_sha",
    "random_seed",
    "promotion_status",
    "no_lookahead_proof"
  ],
  "properties": {
    "schema_version": {
      "const": "senex.calibration.order089.v1"
    },
    "calibration_id": {
      "type": "string",
      "pattern": "^cal089_[0-9a-f]{64}$"
    },
    "decision_protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "source_epochs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clean_baseline_rule",
        "train_epoch_hash",
        "calibration_epoch_hash",
        "quarantine_manifest_hash"
      ],
      "properties": {
        "clean_baseline_rule": {
          "type": "string",
          "minLength": 1
        },
        "train_epoch_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "calibration_epoch_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "quarantine_manifest_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "train_start",
        "train_end_exclusive",
        "calibration_start",
        "calibration_end_exclusive",
        "holdout_start"
      ],
      "properties": {
        "train_start": {
          "type": "string",
          "format": "date-time"
        },
        "train_end_exclusive": {
          "type": "string",
          "format": "date-time"
        },
        "calibration_start": {
          "type": "string",
          "format": "date-time"
        },
        "calibration_end_exclusive": {
          "type": "string",
          "format": "date-time"
        },
        "holdout_start": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "search_space_version",
        "candidate_name",
        "confidence_quantile",
        "ev_quantile",
        "gate_mode"
      ],
      "properties": {
        "search_space_version": {
          "const": "order089-v1"
        },
        "candidate_name": {
          "enum": [
            "BASELINE",
            "CONF_Q60",
            "CONF_Q70",
            "CONF_Q80",
            "EV_Q60",
            "EV_Q70",
            "EV_Q80",
            "CONF_Q70_AND_EV_Q70"
          ]
        },
        "confidence_quantile": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "ev_quantile": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "gate_mode": {
          "enum": [
            "NONE",
            "ABSTENTION_ONLY"
          ]
        }
      }
    },
    "frozen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction_owner",
        "allowed_actions",
        "model_weights",
        "features",
        "risk_scale"
      ],
      "properties": {
        "direction_owner": {
          "const": "SENEX"
        },
        "allowed_actions": {
          "const": [
            "TAKE",
            "ABSTAIN"
          ]
        },
        "model_weights": {
          "const": "FROZEN"
        },
        "features": {
          "const": "NO_NEW_FEATURES"
        },
        "risk_scale": {
          "const": "NOT_CALIBRATED_IN_ORDER089_V1"
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary",
        "pnl_role",
        "coverage_guard"
      ],
      "properties": {
        "primary": {
          "const": "DEPENDENCE_AWARE_INCREMENTAL_DIRECTIONAL_UTILITY"
        },
        "secondary": {
          "const": "FIXED_COST_NORMALIZED_PAPER_UTILITY"
        },
        "pnl_role": {
          "const": "DESCRIPTIVE_ONLY"
        },
        "coverage_guard": {
          "const": "candidate_take_rate >= 0.5 * uncalibrated_take_rate"
        }
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "NO_LOOKAHEAD",
          "NO_INCIDENT_OVERLAP",
          "CHRONOLOGICAL_SPLIT",
          "SAME_HOUR_CLUSTERING",
          "NO_RANDOM_TIME_SHUFFLE",
          "NO_D1",
          "NO_LIVE",
          "NO_BROKER_WALLET_SIGNER",
          "NO_SELF_MODIFYING_PRODUCTION",
          "MODEL_VENDOR_AGNOSTIC"
        ]
      }
    },
    "code_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "random_seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "promotion_status": {
      "enum": [
        "DRAFT",
        "OFFLINE_REPLAY",
        "SHADOW_PAPER",
        "FIXED_CALIBRATION_PAPER",
        "HOLDOUT_PENDING",
        "HOLDOUT_PASSED",
        "HOLDOUT_FAILED",
        "ROLLED_BACK"
      ]
    },
    "no_lookahead_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_hash_set",
        "decision_freeze_before_settlement",
        "current_market_access"
      ],
      "properties": {
        "packet_hash_set": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decision_freeze_before_settlement": {
          "const": true
        },
        "current_market_access": {
          "const": false
        }
      }
    },
    "evaluation_provenance": {
      "description": "Optional evidence metadata; excluded from calibration_id semantics.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id",
          "policy_id",
          "policy_version"
        ],
        "properties": {
          "agent_id": {
            "type": "string",
            "minLength": 1
          },
          "policy_id": {
            "type": "string",
            "minLength": 1
          },
          "policy_version": {
            "type": "string",
            "minLength": 1
          },
          "model_provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "model_name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
